        "is_silent": false,
        "lines": [
          {
            "text": "好作文一定是父母帮出来的",
            "start_ms": 0,
            "end_ms": 2600,
            "spans_shot_boundary": false
          },
          {
            "text": "其实呀",
            "start_ms": 2600,
            "end_ms": 3600,
            "spans_shot_boundary": false
          },
          {
            "text": "就一个敲门",
            "start_ms": 3600,
            "end_ms": 5300,
            "spans_shot_boundary": false
          },
          {
            "text": "你从今天开始增加一个小步骤",
            "start_ms": 5300,
            "end_ms": 8200,
            "spans_shot_boundary": false
          },
          {
            "text": "漫娃每天放学回家",
            "start_ms": 8200,
            "end_ms": 10300,
            "spans_shot_boundary": false
          },
          {
            "text": "花十分钟去看这本",
            "start_ms": 10300,
            "end_ms": 12500,
            "spans_shot_boundary": false
          },
          {
            "text": "新视角写高分作文",
            "start_ms": 12500,
            "end_ms": 14500,
            "spans_shot_boundary": false
          },
          {
            "text": "不多",
            "start_ms": 14500,
            "end_ms": 15400,
            "spans_shot_boundary": false
          },
          {
            "text": "一个月的时间你就能看到它的变化",
            "start_ms": 15400,
            "end_ms": 18400,
            "spans_shot_boundary": false
          },
          {
            "text": "比如我们要用翻和这个词来照据",
            "start_ms": 18400,
            "end_ms": 22300,
            "spans_shot_boundary": false
          },
          {
            "text": "普通的娃就会写",
            "start_ms": 22300,
            "end_ms": 23800,
            "spans_shot_boundary": false
          },
          {
            "text": "我翻开了一本书",
            "start_ms": 23800,
            "end_ms": 25300,
            "spans_shot_boundary": false
          },
          {
            "text": "看了看又合上了",
            "start_ms": 25300,
            "end_ms": 27500,
            "spans_shot_boundary": false
          },
          {
            "text": "很普通",
            "start_ms": 27500,
            "end_ms": 28700,
            "spans_shot_boundary": false
          },
          {
            "text": "但是看过这本新视角的网",
            "start_ms": 28700,
            "end_ms": 30700,
            "spans_shot_boundary": false
          },
          {
            "text": "它会写",
            "start_ms": 30700,
            "end_ms": 31600,
            "spans_shot_boundary": true
          }
        ]
