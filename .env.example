# 配置示例。复制为 .env.dev / .env.test / .env.prod 后按环境填写。
#
# 规则（app/platform/config.py 会在启动时强制校验）：
#   1. 每个环境一个文件，密钥不共享；三个文件都不入库（见 .gitignore）
#   2. 库名必须以 vf_{env} 开头，桶名必须以 vf-{env}- 开头
#      —— 配错环境的结果是连不上，而不是静默连到别的环境
#   3. 原始资产与生成资产必须分桶
#   4. 生产环境：禁止 mock 供应商、禁止弱口令、必须设成本上限
#
# 生产环境不应使用本文件。密钥请由集中式密钥管理注入环境变量（设计文档 13.2），
# 不要落盘。环境变量优先于文件。

VF_ENVIRONMENT=dev

# ---------------------------------------------------------------- PostgreSQL
VF_DATABASE__HOST=localhost
VF_DATABASE__PORT=5432
VF_DATABASE__USER=video_factory
VF_DATABASE__PASSWORD=local_dev_only
VF_DATABASE__NAME=vf_dev

# ---------------------------------------------------------------- Redis
VF_REDIS__HOST=localhost
VF_REDIS__PORT=6379
VF_REDIS__DB=0

# ---------------------------------------------------------------- 对象存储
VF_STORAGE__ENDPOINT=http://localhost:9000
VF_STORAGE__ACCESS_KEY=video_factory
VF_STORAGE__SECRET_KEY=local_dev_only
VF_STORAGE__BUCKET_RAW=vf-dev-raw
VF_STORAGE__BUCKET_GENERATED=vf-dev-generated
# 签名链接有效期（秒）。设计文档 11.1 要求使用短时有效的签名链接。
VF_STORAGE__SIGNED_URL_TTL_SECONDS=900

# ---------------------------------------------------------------- 视频生成供应商
# dev/test 用 mock，零费用（设计计划 T5-3）。生产必须填真实供应商与密钥。
VF_VIDEO_PROVIDER__NAME=mock
# VF_VIDEO_PROVIDER__API_KEY=
VF_VIDEO_PROVIDER__TIMEOUT_SECONDS=3600

# ---------------------------------------------------------------- 成本上限
# 0 表示不限制，仅 dev/test 允许。生产环境必须为正数。
VF_BUDGET__MAX_COST_PER_VIDEO=0
VF_BUDGET__MAX_COST_PER_WORKFLOW_RUN=0
