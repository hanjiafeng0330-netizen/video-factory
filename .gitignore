# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/

# 工具缓存
.ruff_cache/
.mypy_cache/
.pytest_cache/

# macOS 在 exFAT 卷上生成的 AppleDouble 伴生文件与目录元数据
._*
.DS_Store
.Spotlight-V100
.Trashes
.fseventsd
.TemporaryItems

# 本地配置与密钥
.env
.env.*
!.env.example
*.pem
*.key

# 本地媒体产物（不入库，走对象存储）
# 注意目录名带前导点：写成 /local_assets/ 会漏掉 .local_assets/，
# 实测漏过一次——1MB 的视频与关键帧被提交进了仓库。
/tmp/
/.local_assets/
/local_assets/
